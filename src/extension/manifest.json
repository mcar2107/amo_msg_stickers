{
  "manifest_version": 3,
  "name": "amo stickers",
  "version": "0.18.0",
  "key": "",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "amo stickers",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "default_locale": "ru",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.giphy.com/*",
    "https://*.giphy.com/*",
    "https://api.klipy.com/*",
    "https://*.klipy.com/*",
    "https://api.telegram.org/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.amo.tm/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.amo.tm/*"],
      "js": ["page.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
