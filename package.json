{
  "name": "amo-stickers",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "harness": "node dev/harness-server.mjs",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit && node node_modules/typescript-native/bin/tsc --noEmit -p docs/tsconfig.json",
    "test": "vitest run --project=unit --passWithNoTests",
    "test:watch": "vitest --project=unit",
    "lint": "concurrently --kill-others-on-fail \"pnpm lint:es\" \"pnpm typecheck\" \"pnpm lint:format\" \"pnpm lint:knip\" \"pnpm lint:sg\" \"pnpm lint:agents\" \"pnpm lint:actions\"",
    "lint:es": "eslint . --cache --cache-strategy=content",
    "lint:fix": "eslint . --fix",
    "lint:format": "prettier --check .",
    "lint:knip": "knip --no-progress",
    "lint:sg": "mise x -- ast-grep scan && mise x -- ast-grep test",
    "lint:agents": "mise x -- agnix --strict .",
    "lint:actions": "mise x -- jactionlint",
    "lint:secrets": "mise x -- betterleaks git . --redact --no-banner",
    "lint:deps": "mise x -- osv-scanner scan source --config=osv-scanner.toml -L pnpm-lock.yaml -L docs/pnpm-lock.yaml",
    "lint:links": "mise x -- lychee --config lychee.toml README.md \"docs/**/*.md\"",
    "size": "size-limit",
    "format": "prettier --write .",
    "skills:update": "openspec update",
    "docs:dev": "pnpm -C docs dev",
    "docs:build": "pnpm -C docs build",
    "docs:preview": "pnpm -C docs preview",
    "postinstall": "node scripts/init-env.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fission-ai/openspec": "1.13.2",
    "@size-limit/file": "14.3.0",
    "@types/chrome": "^0.3.6",
    "concurrently": "10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "63.3.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unicorn": "65.0.1",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "knip": "6.43.0",
    "lint-staged": "17.6.0",
    "postcss": "^8.5.31",
    "prettier": "3.9.10",
    "size-limit": "14.3.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "typescript-native": "npm:typescript@^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "gifenc": "^1.0.3",
    "lottie-web": "^5.13.0",
    "preact": "^10.29.8"
  }
}
