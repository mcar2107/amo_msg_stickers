{
  "name": "amo-stickers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "harness": "node dev/harness-server.mjs",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit && node node_modules/typescript-native/bin/tsc --noEmit -p docs/tsconfig.json",
    "test": "vitest run --project=unit --passWithNoTests",
    "test:watch": "vitest --project=unit",
    "lint": "concurrently --kill-others-on-fail \"pnpm lint:es\" \"pnpm typecheck\" \"pnpm lint:format\"",
    "lint:es": "eslint . --cache --cache-strategy=content",
    "lint:fix": "eslint . --fix",
    "lint:format": "prettier --check .",
    "format": "prettier --write .",
    "skills:update": "openspec update",
    "docs:dev": "pnpm -C docs dev",
    "docs:build": "pnpm -C docs build",
    "docs:preview": "pnpm -C docs preview",
    "postinstall": "node scripts/init-env.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fission-ai/openspec": "1.13.2",
    "@types/chrome": "^0.3.4",
    "concurrently": "10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "63.3.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unicorn": "65.0.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "postcss": "^8.5.28",
    "prettier": "3.9.9",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "typescript-native": "npm:typescript@^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "gifenc": "^1.0.3",
    "lottie-web": "^5.13.0",
    "preact": "^10.29.8"
  }
}
