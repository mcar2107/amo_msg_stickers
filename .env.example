# Шаблон .env для разработки. `pnpm i` копирует его в .env, если .env ещё нет; .env в git не лежит.
#
# Значения читает сервер стенда `pnpm harness` (dev/harness-server.mjs) и кладёт их в настройки
# стенда. Сборка .env не читает: встроенный токен бота она берёт из переменной окружения
# TELEGRAM_BOT_TOKEN самой команды `pnpm build`.

# Ключ GIPHY API: https://developers.giphy.com/dashboard/
GIPHY_KEY=

# Ключ KLIPY API: https://partner.klipy.com/
KLIPY_KEY=

# Токен Telegram-бота от @BotFather — для импорта паков на стенде.
TELEGRAM_BOT_TOKEN=
