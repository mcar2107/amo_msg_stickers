# Шаблон .env для разработки. `pnpm i` копирует его в .env, если .env ещё нет; .env в git не лежит.
#
# Значения читает сервер стенда `pnpm harness` (dev/harness-server.mjs) и кладёт их в настройки
# стенда. Сборка .env не читает: встроенный токен бота и встроенный ключ KLIPY она берёт из
# переменных окружения TELEGRAM_BOT_TOKEN и KLIPY_API_KEY самой команды `pnpm build`.

# Ключ GIPHY API: https://developers.giphy.com/dashboard/
GIPHY_KEY=

# Ключ KLIPY API: https://partner.klipy.com/ — свой ключ стенда, как из «Настроек». Встроенный
# ключ сборки — переменная KLIPY_API_KEY у `pnpm build`, стенд её не читает.
KLIPY_KEY=

# Токен Telegram-бота от @BotFather — для импорта паков на стенде.
TELEGRAM_BOT_TOKEN=
